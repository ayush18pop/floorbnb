# Names only. Real values live in ~/.config/floor/secrets.env (chmod 600), never in the repo.
BSC_RPC_URL=
# BSC_FORK_RPC_URL: archive-capable BSC RPC used by `pnpm local:up` for the anvil fork (value is secret; load with set -a; . .env; set +a)
BSC_FORK_RPC_URL=
BW3_API_KEY=
BW3_API_SECRET=
ETHERSCAN_API_KEY=
KEEPER_PRIVATE_KEY=
KEEPER_SIGNER=
BAW_KEEPER_ADDRESS=
# b402 uses BW3_API_KEY/BW3_API_SECRET (key needs "B402 Payments"); optional override:
B402_BASE_URL=
X402_PAYTO=
SELF_FACILITATOR_KEY=
ALERT_WEBHOOK_URL=
HEALTHCHECK_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MCP_URL=
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Keeper (A09)
FLOOR_FACTORY=
FLOOR_LENS=
KEEPER_ADDRESS=
KEEPER_ROUTE=direct
KEEPER_INTERVAL_SEC=60

# Launch lock (names only). The app pages (/app, /agents, /api) are LOCKED unless this is exactly 0.
# Unset or any other value = locked (safe default). Local stack (pnpm local:up) sets it to 0.
# Vercel: set NEXT_PUBLIC_APP_LOCKED=0 in the Production scope at mainnet launch, then redeploy. See docs/BRANCHING.md.
NEXT_PUBLIC_APP_LOCKED=
APP_LOCKED=
