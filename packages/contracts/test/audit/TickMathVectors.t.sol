pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {TickMath} from "../../src/libs/vendor/TickMath.sol";

/// @notice A12 audit: the vendored TickMath matches an independent high-precision reference (Python Decimal, 120 digits).
///         Reference sqrtP = sqrt(1.0001^tick) * 2^96, truncated. Uniswap rounds up, so the library may be 0..2 above
///         it (relative error below 1e-12 at the extremes). PASSES today; kept as a regression guard.
contract TickMathVectorsTest is Test {
    function _check(int24 tick, uint256 ref) internal pure {
        uint256 got = TickMath.getSqrtPriceAtTick(tick);
        uint256 diff = got > ref ? got - ref : ref - got;
        // allow 1e-12 relative (+2 absolute for tiny prices)
        require(diff <= ref / 1e12 + 2, "TickMath vector mismatch");
    }

