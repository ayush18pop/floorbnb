{
  "name": "@floor/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/bin.ts",
    "once": "tsx src/bin.ts once",
    "test:fork": "FLOOR_FORK=1 vitest run fork.test",
    "test:fork-agg": "FLOOR_FORK=1 FLOOR_LIVE=1 vitest run fork-agg",
    "fork": "bash scripts/fork.sh"
  },
  "dependencies": {
    "@floor/bw3": "workspace:*",
    "@floor/sdk": "workspace:*",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "bin": {
    "keeper": "src/bin.ts"
  }
}
