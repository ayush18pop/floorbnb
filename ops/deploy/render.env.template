# Render env for floor-server. Dashboard: Environment > Add from .env (paste the whole file).
# Blank values are not set; fill them first. NEVER commit a filled copy.

# Already known / fixed (safe to leave as is)
NODE_VERSION=20.20.2
FLOOR_CHAIN_ID=56
TRUST_PROXY=1
WEB_ORIGIN=https://floorbnb.vercel.app
X402_NETWORK=eip155:56
X402_FACILITATOR=self
KEEPER_ADDRESS=0x46FD797AeBD0250A2E768022AD992DF21F12e58a
KEEPER_ROUTE=direct
KEEPER_INTERVAL_SEC=60
X402_ASSET_DECIMALS=18
PRICE_QUOTE_PROTECTION_USD=0.01
PRICE_BACKTEST_USD=0.01
